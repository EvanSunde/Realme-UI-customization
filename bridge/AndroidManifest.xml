<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="np.evan.musicbridge" android:versionCode="1" android:versionName="0.1">
 <!-- Target 28 on purpose: Realme's lock-screen engine starts the service with startForegroundService, and this keeps the
      test free of Android 14's foreground-service type rules and scoped storage while we find out what works. -->
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
 <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
 <application android:label="Studio Music Bridge" android:icon="@android:drawable/ic_media_play" android:requestLegacyExternalStorage="true" android:allowBackup="false">
  <activity android:name=".BridgeActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <!-- The lock-screen engine looks for exactly one service answering this action. -->
  <service android:name=".BridgeService" android:exported="true">
   <intent-filter><action android:name="com.oplus.music.service.command"/></intent-filter>
  </service>
  <service android:name=".MediaListener" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
   <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
  </service>
 </application>
</manifest>
